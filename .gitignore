# Clés de signature et secrets
release-keys/
*.jks
*.keystore
key.properties

# Poids de modèles (fiche et SHA-256 dans models/)
models/**/*.onnx
models/**/*.bin

# Ordinateur
.DS_Store
.idea/
.vscode/
.claude/

# Modèle : poids et configuration, téléchargés par models/preparer_pix2text.py
models/pix2text-mfr/
# Sources et produits de compilation de Giac
native/giac/sources/
native/giac/construit/

# Versions préparées
release-out/

# Écriture collectée (ADR 0038) : hors Git tant qu'Antsa ne la publie pas.
/donnees/

# Entraînement du modèle de signes : polices téléchargées, environnement et poids produits.
# La version adoptée des poids sera ajoutée à part (décision à venir, ADR 0040).
/entrainement/polices/
/entrainement/.venv/
/entrainement/sortie/
/entrainement/**/__pycache__/
/entrainement/.pytest_cache/

# Petit modèle par signe : embarqué à la construction, hors Git tant qu'une version n'est pas adoptée.
/app/assets/modeles/signes*

# Plateforme des dons : environnement, secrets et dons reçus en essai.
/plateforme/.venv/
/plateforme/.env
/plateforme/dons-recus/
/plateforme/**/__pycache__/
/plateforme/.pytest_cache/
/plateforme/cloudrun.env.yaml
