    "guideDocumentsTitre": "New document, History",
    "guideDocumentsPhrase": "Menu › New document opens a blank sheet, with its Figure; Menu › History reopens the sheets already written, which are kept automatically.",
    "guideDocumentsMots": "document new history open sheet save",
    "guideModeleTitre": "The reading model",
    "guideModelePhrase": "Settings › Download the model, only once: it reads what the strokes alone do not recognise. Your handwriting stays on the device.",
    "guideModeleMots": "model download reading recognition offline",
    "guideMiseAJourTitre": "Update",
    "guideMiseAJourPhrase": "Settings › Check for updates: the app only looks for a new version when you ask.",
    "guideMiseAJourMots": "update version new install",
    "guideEcrituresTitre": "My writing",
    "guideEcrituresPhrase": "Settings › Export my writing saves it in the collection format, wherever you choose; Delete my writing forgets it, corrections included.",
    "guideEcrituresMots": "handwriting export erase corrections collection",
    "guideDonsTitre": "Help improve recognition",
    "guideDonsPhrase": "Settings: if you tick the box, your judged lines are sent without your name, on Wi-Fi only if you want. Untick at any time, or ask to withdraw your donations.",
    "guideDonsMots": "donations help improve recognition send consent withdraw wifi",
