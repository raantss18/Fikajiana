# Copier en `.env` (jamais dans Git) et remplir.
# Nom de domaine qui pointe vers ce serveur (enregistrement DNS A/AAAA).
FIKA_DOMAINE=dons.exemple.org
# Jeton de l'export : 32 caractères au moins. En tirer un : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FIKA_JETON_ADMIN=
# Débit permis par IP : FIKA_DEBIT requêtes par FIKA_FENETRE secondes.
FIKA_DEBIT=30
FIKA_FENETRE=60
# Stockage S3 au lieu du disque (laisser vide pour le disque) :
FIKA_S3_SEAU=
FIKA_S3_ADRESSE=
FIKA_S3_REGION=
FIKA_S3_PREFIXE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
